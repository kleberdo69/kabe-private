#!/system/bin/sh
# ═══════════════════════════════════════════════════════
#   KABE PRIVATE — Key Generator
#   Gera/exibe a key de acesso ao painel
# ═══════════════════════════════════════════════════════

KEY_FILE="/data/adb/kabe/key"

mkdir -p /data/adb/kabe
chmod 700 /data/adb/kabe

if [ -f "$KEY_FILE" ]; then
    echo ""
    echo "  ============================================"
    echo "            KABE PRIVATE — KEY"
    echo "  ============================================"
    echo ""
    echo "  Key: $(cat $KEY_FILE)"
    echo ""
    echo "  Para gerar novamente:"
    echo "    rm $KEY_FILE && kabe-keygen"
    echo ""
    exit 0
fi

KEY="KABE-$(cat /dev/urandom | tr -dc 'A-Z0-9' | head -c 16)"
echo "$KEY" > "$KEY_FILE"
chmod 600 "$KEY_FILE"

echo ""
echo "  ============================================"
echo "      KABE PRIVATE — KEY GERADA"
echo "  ============================================"
echo ""
echo "  Key: $KEY"
echo ""
echo "  1. Copie esta key"
echo "  2. Abra o painel KABE PRIVATE"
echo "  3. Cole a key na aba de conexao"
echo ""
echo "  Arquivo: $KEY_FILE"
echo ""
