#!/system/bin/sh
LOG="/data/local/tmp/kabe.log"
CONFIG="/data/adb/kabe/config"
KEY_FILE="/data/adb/kabe/key"
log() { echo "[$(date '+%H:%M:%S')] $1" >> $LOG; }
if [ ! -f "$CONFIG" ] || [ ! -f "$KEY_FILE" ]; then
    log "Config missing. Run kabe-setup."
    exit 1
fi
SERVER=$(grep "^SERVER=" "$CONFIG" | cut -d= -f2-)
KEY=$(cat "$KEY_FILE" | tr -d '\n\r ')
SERIAL=$(getprop ro.serialno 2>/dev/null || echo "unknown")
MODEL=$(getprop ro.product.model 2>/dev/null || echo "unknown")
ANDROID=$(getprop ro.build.version.release 2>/dev/null || echo "unknown")
[ -z "$SERVER" ] || [ -z "$KEY" ] && { log "Empty SERVER/KEY"; exit 1; }
log "Starting agent -> $SERVER ($MODEL)"
wget -q -O /tmp/kabe_reg --post-data="key=$KEY&id=$SERIAL&model=$MODEL&android=$ANDROID" "$SERVER/api/agent/register" 2>/dev/null
[ $? -ne 0 ] && { log "Cannot reach server"; exit 1; }
log "Registered"
while true; do
    wget -q -O /tmp/kabe_resp --timeout=10 "$SERVER/api/agent/poll?key=$KEY" 2>/dev/null
    if [ -s /tmp/kabe_resp ]; then
        BODY=$(cat /tmp/kabe_resp)
        CMD_ID=$(echo "$BODY" | sed 's/.*"id":\([0-9]*\).*/\1/')
        CMD=$(echo "$BODY" | sed 's/.*"cmd":"\([^"]*\)".*/\1/')
        CMD=$(echo "$CMD" | sed 's/\\n/\n/g;s/\\t/\t/g;s/\\"/"/g;s/\\\\/\\/g')
        if [ "$CMD_ID" != "$BODY" ] && [ -n "$CMD" ] && [ "$CMD_ID" != "" ]; then
            log "CMD[$CMD_ID]: $(echo "$CMD" | head -c 100)"
            OUTPUT=$(su -c "$CMD" 2>&1)
            EXIT=$?
            OUT_B64=$(echo "$OUTPUT" | base64 2>/dev/null)
            wget -q -O /dev/null --post-data="key=$KEY&id=$CMD_ID&exit=$EXIT&data=$OUT_B64" "$SERVER/api/agent/output" 2>/dev/null
            log "Output sent (exit=$EXIT)"
        fi
    fi
    sleep 2
done
